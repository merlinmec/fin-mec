#!/bin/sh
# Recusa commit com o Claude como coautor: o autor deste repositório é só o dono dele, e um
# "Co-Authored-By: Claude" faz o Claude aparecer em Contributors no GitHub (já aconteceu, e
# precisou reescrever o histórico da main). Outros coautores humanos continuam permitidos.
#
# Uso: hook commit-msg do git (ative com `git config core.hooksPath .githooks`) e também a CI,
# que roda este mesmo script na mensagem de cada commit da PR.

msg_file="$1"

if grep -qiE '^(co-authored-by:.*(claude|anthropic)|claude-session:)' "$msg_file"; then
  echo "commit recusado: a mensagem tem trailer de coautoria do Claude:" >&2
  grep -iE '^(co-authored-by:.*(claude|anthropic)|claude-session:)' "$msg_file" | sed 's/^/  /' >&2
  echo "remova essa(s) linha(s) e faça o commit de novo." >&2
  exit 1
fi
