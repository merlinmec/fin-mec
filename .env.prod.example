# Copie para .env.prod (nunca commitado) e preencha. Ver docs/DEPLOY.md.

# Domínio público apontando (registro A/AAAA) para a VPS. O Caddy emite o HTTPS sozinho.
DOMAIN=financas.exemplo.com.br
MECFIN_BASE_URL=https://financas.exemplo.com.br

# Banco (fica só na rede interna do compose). Senha forte: openssl rand -base64 24
DB_NAME=mecfin
DB_USER=mecfin
DB_PASSWORD=

# AES-256 que cifra o segredo do 2FA: openssl rand -base64 32
# GUARDE UMA CÓPIA FORA DA VPS: sem ela, ninguém com 2FA ativo consegue mais entrar.
MECFIN_ENCRYPTION_KEY=

# SMTP transacional (recuperação de senha, alertas de acesso). Qualquer provedor com SMTP:
# Brevo, Resend, Amazon SES, Mailgun... O remetente precisa estar verificado no provedor.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=fin-mec <no-reply@financas.exemplo.com.br>

BACKUP_KEEP_DAYS=14
