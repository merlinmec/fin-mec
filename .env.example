# Copie para .env e preencha com valores locais.
# .env nunca deve ser commitado (ver .gitignore).
# Nunca use credenciais reais de banco/produção aqui.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mecfin
DB_USER=mecfin
DB_PASSWORD=troque-por-uma-senha-local-qualquer

SPRING_PROFILES_ACTIVE=dev

# Chave AES-256 (base64, 32 bytes) que cifra o segredo do 2FA. Obrigatória fora do perfil dev.
# Gere com: openssl rand -base64 32
MECFIN_ENCRYPTION_KEY=

# E-mail (recuperação de senha, alertas). Em dev, com o Mailpit do docker-compose:
#   MAIL_HOST=localhost  MAIL_PORT=1025  MAIL_SMTP_AUTH=false  MAIL_STARTTLS=false
# e a caixa de entrada fica em http://localhost:8025. Sem MAIL_HOST, o e-mail só vai para o log.
MAIL_HOST=
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MECFIN_BASE_URL=http://localhost:5173

# Open Finance via Pluggy (Fase 16) — credenciais em https://dashboard.pluggy.ai.
# Sem elas, a tela "Bancos conectados" fica desligada. PLUGGY_INCLUDE_SANDBOX=true mostra o banco de testes.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_INCLUDE_SANDBOX=false
